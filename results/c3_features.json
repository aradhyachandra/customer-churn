  "features": [
    {
      "name": "recency_days",
      "definition": "Whole days from the last purchase day to the cutoff date (1 = bought the day before)."
    },
    {
      "name": "orders_90d",
      "definition": "Purchase events in the 90 days before the cutoff."
    },
    {
      "name": "orders_180d",
      "definition": "Purchase events in the 180 days before the cutoff."
    },
    {
      "name": "orders_365d",
      "definition": "Purchase events in the 365 days before the cutoff."
    },
    {
      "name": "net_revenue_90d",
      "definition": "Net value (£) of all lines, purchases minus returns, in the 90 days before the cutoff."
    },
    {
      "name": "net_revenue_180d",
      "definition": "Net value (£) of all lines in the 180 days before the cutoff."
    },
    {
      "name": "net_revenue_365d",
      "definition": "Net value (£) of all lines in the 365 days before the cutoff (trailing 12-month revenue)."
    },
    {
      "name": "avg_order_value_365d",
      "definition": "Value (£) of purchase events in the last 365 days divided by their number."
    },
    {
      "name": "orders_trend_90d",
      "definition": "Purchase events in the last 90 days minus those in the 90 days before them."
    },
    {
      "name": "net_revenue_trend_90d",
      "definition": "Net value (£) in the last 90 days minus net value in the 90 days before them."
    },
    {
      "name": "single_purchase_day_365d",
      "definition": "1 if the customer bought on only one day in the last 365 days (gap features then use fill values)."
    },
    {
      "name": "avg_gap_days",
      "definition": "Mean days between consecutive purchase days in the last 365 days (365 if only one purchase day)."
    },
    {
      "name": "latest_gap_days",
      "definition": "Days between the last two purchase days in the last 365 days (365 if only one purchase day)."
    },
    {
      "name": "latest_gap_ratio",
      "definition": "latest_gap_days / avg_gap_days (above 1: the last gap was longer than usual)."
    },
    {
      "name": "recency_gap_ratio",
      "definition": "recency_days / avg_gap_days (above 1: already waiting longer than the usual gap)."
    },
    {
      "name": "tenure_days",
      "definition": "Whole days from the first purchase day in the data to the cutoff date."
    },
    {
      "name": "first_seen_first_data_month",
      "definition": "1 if the first purchase is in the first data month (Dec 2009): tenure is a lower bound."
    },
    {
      "name": "distinct_products_365d",
      "definition": "Distinct stock codes (upper-cased, stripped) in purchase events in the last 365 days."
    },
    {
      "name": "return_rate_365d",
      "definition": "Value returned / value bought in the last 365 days; same-day full cancellations count on neither side. Can exceed 1 when earlier purchases are returned."
    },
    {
      "name": "is_uk",
      "definition": "1 if the country on the customer's latest line before the cutoff is the United Kingdom."
    },
    {
      "name": "bought_in_peak_365d",
      "definition": "1 if the customer bought in the November or December inside the last 365 days."
    }
  ],
